<?xml version="1.0" encoding="UTF-8"?>
<manifest>
	<remote name="origin" fetch="../../"/>
	<option>
		<branch-release>master</branch-release>
		<branch-develop>dev</branch-develop>
		<default-branch>dev</default-branch>
		<default-remote>origin</default-remote>
		<synchronize-submodule>true</synchronize-submodule>
	</option>
	<project name="atria-tools/island.git"    path="island"/>
	<project name="atria-tools/lutin.git"     path="lutin"/>
	<project name="atria-tools/estyle.git"    path="estyle"/>
	<project name="atria-tools/monk.git"      path="monk"/>
	<project name="atria-tools/doxy.git"      path="doxy"/>
	<project name="atria-tools/prude.git"     path="prude"/>
	<project name="atria-tools/death.git"     path="death"/>
	<project name="atria-tools/qworktree.git" path="qworktree"/>
	<project name="atria-tools/realog.git"    path="realog"/>
	<!-- Create some tooling elements -->
	<link source=".island/manifest/README.md" destination="README.md"/>
</manifest>
